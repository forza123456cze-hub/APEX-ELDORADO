 // -----------------------------
 // Combos (Macros)
 // -----------------------------
 combo RapidFire {
  if (rapidFireState == 0) {
  set_val(Fire, 0);
  rapidFireState = 1;
  } else {
  set_val(Fire, 100);
  rapidFireState = 0;
  }
 }
 

 combo CrouchSpam {
  if (crouchSpamState == 0) {
  set_val(CrouchButton, 100);
  crouchSpamState = 1;
  } else {
  set_val(CrouchButton, 0);
  crouchSpamState = 0;
  }
 }
 

 // NEW: tBag combo
 combo TBag {
  if (tBagState == 0) {
  set_val(CrouchButton, 100);
  tBagState = 1;
  } else {
  set_val(CrouchButton, 0);
  tBagState = 0;
  }
 }
 

combo ShaikoCrouchCombo {
 // Crouch at start if enabled
    if (ShaiikoCrouchToggle) {
        set_val(CrouchButton, 100);
    }
    wait(50);  

    if (ShaiikoCrouchToggle) {
        set_val(CrouchButton, 0);
    }
    wait(150);

    if (ShaiikoCrouchToggle) {
        set_val(CrouchButton, 100);
    }
    wait(50);

    if (ShaiikoCrouchToggle) {
        set_val(CrouchButton, 0);
    }
}
 
combo LeanOnceLS {
    // LEFT LEAN = nudge left
    if(abs(get_val(XB1_LX)) < 20) {
        set_val(XB1_LX, -60);
    }
    set_val(XB1_RS, 100);       // Melee (left lean input)
    wait(shaiikoPeekDelay);

    set_val(XB1_LS, 100);       // Sprint

    // RIGHT LEAN = nudge right
    if(abs(get_val(XB1_LX)) < 20) {
        set_val(XB1_LX, 60);
    }
    set_val(XB1_RS, 100);       // Melee
    wait(shaiikoPeekDelay);

    set_val(XB1_LS, 100);       // Sprint

    // RIGHT LEAN = nudge right again
    if(abs(get_val(XB1_LX)) < 20) {
        set_val(XB1_LX, 60);
    }
    set_val(XB1_RS, 100);       // Melee
    wait(10);

    set_val(XB1_LS, 100);       // Sprint
    
    wait(200); // Final delay

    // Explicit crouch release to ensure standing up
    if (ShaiikoCrouchToggle) {
        set_val(CrouchButton, 0);
    }
}

combo LeanOnceRS {
    // RIGHT LEAN = nudge right (was left)
    if(abs(get_val(XB1_LX)) < 20) {
        set_val(XB1_LX, 60); // inverted from -60
    }
    set_val(XB1_LS, 100);       // Melee (right lean input)
    wait(shaiikoPeekDelay);

    set_val(XB1_RS, 100);       // Sprint (was LS)

    // LEFT LEAN = nudge left (was right)
    if(abs(get_val(XB1_LX)) < 20) {
        set_val(XB1_LX, -60); // inverted from 60
    }
    set_val(XB1_LS, 100);       // Melee
    wait(shaiikoPeekDelay);

    set_val(XB1_RS, 100);       // Sprint (was LS)

    // LEFT LEAN = nudge left again (was right again)
    if(abs(get_val(XB1_LX)) < 20) {
        set_val(XB1_LX, -60); // inverted from 60
    }
    set_val(XB1_LS, 100);       // Melee
    wait(10);

    set_val(XB1_RS, 100);       // Sprint (was LS)
    
    wait(200); // Final delay

    // Explicit crouch release to ensure standing up
    if (ShaiikoCrouchToggle) {
        set_val(CrouchButton, 0);
    }
}
 

 combo ShotAbuseRelease {
  set_val(ADS, 0);
  wait(aimOutDelay);
  set_val(ADS, 100);
 }
 

 combo RSJitter {
  jitterX = random(-rsJitterStrength, rsJitterStrength);
  jitterY = random(-rsJitterStrength, rsJitterStrength);
 

  set_val(XB1_RX, jitterX);
  set_val(XB1_RY, jitterY);
 

  wait(jitterDelay);
 }
 

 combo HipLeft {
  set_val(ADS, 100);
  wait(HipLeanDelay);
  set_val(ADS, 100);
  set_val(LeanLeft, 100);
  wait(100);
  set_val(ADS, 0);
  set_val(LeanLeft, 0);
 }
 

 int flickerToggle = FALSE;
 int flickerTimer = 0;
 

 combo HipRight {
  set_val(ADS, 100);
  wait(HipLeanDelay);
  set_val(ADS, 100);
  set_val(LeanRight, 100);
  wait(120);
  set_val(ADS, 0);
  set_val(LeanRight, 0);
 }
 

 // Lean Spam Combo
 combo LeanSpam {
  set_val(LeanLeft, 100);
  wait(100);
  set_val(LeanLeft, 0);
  set_val(LeanRight, 100);
  wait(100);
  set_val(LeanRight, 0);
 }
 

 combo PronePeekCombo {
  crouchOverride = TRUE;
  set_val(CrouchButton, 100);
  wait(500);
  set_val(CrouchButton, 0);
 }
 

 // Stand up after firing combo
 combo StandUpCombo {
  crouchOverride = TRUE;
  set_val(CrouchButton, 100);
  wait(500);
  set_val(CrouchButton, 0);
 }
 

 int currSwitchButton;
 

 // -----------------------------
 // Main Loop
 // -----------------------------
 main {
 

  if (!inMenu) {
  antiRecoilAdjust = FALSE;
  antiRecoilAdjustMode = 1;
  sideSelected = FALSE;
  WeaponSelectMode = FALSE;
  WeaponSpecificSelectMode = FALSE;
  
  // Reset mod adjustment flags
  rapidFireAdjust = FALSE;
  crouchSpamAdjust = FALSE;
  shaiikoPeekAdjust = FALSE;
  shotAbuseAdjust = FALSE;
  rsJitterAdjust = FALSE;
  crouchShotAdjust = FALSE;
  hipLeanAdjust = FALSE;
  leanSpamAdjust = FALSE;
  PronePeekAdjust = FALSE;
  
  currentModAdjustMode = 1;
  crouchSpamAdjustMode = 1;
  }
  
  currMenu  = get_val(XB1_MENU);
  currLT = get_val(XB1_LT);
  currB  = get_val(XB1_B);
  currRight = get_val(XB1_RIGHT);
  currLeft = get_val(XB1_LEFT);
  currUp = get_val(XB1_UP);
  currDown = get_val(XB1_DOWN);
  currA  = get_val(XB1_A);
  
  // Track Weapon switching (only when not in menu)
  if (!inMenu) {
  currSwitchButton = get_val(Switch);
  
  // Y button just pressed - start timer
  if (currSwitchButton && !prevSwitchButton) {
  switchPressTime = 0;
  switchHeld = TRUE;
  }
  
  // Y button held - count time
  if (currSwitchButton && switchHeld) {
  switchPressTime += 10; // Time in milliseconds (10ms per loop)
  }
  
  // Y button released - check if it was a short press
  if (!currSwitchButton && prevSwitchButton && switchHeld) {
  if (switchPressTime < 150) {
  // Short press - switch weapon
  if (currentWeapon == 1) {
  currentWeapon = 2; // Switch to secondary
  } else {
  currentWeapon = 1; // Switch to primary
  }
  }
  switchHeld = FALSE; // Reset hold state
  }
  
  prevSwitchButton = currSwitchButton;
  }
  
  // Toggle menu with Menu + LT
  if (currMenu && currLT && (!prevMenu || !prevLT)) {
  inMenu = !inMenu;
  msTimer = 0;
  ignoreInputTimer = 20;
  if (inMenu) {
  menuMode = 1;
  sideSelected = FALSE;
  WeaponSelectMode = FALSE;
  WeaponSpecificSelectMode = FALSE;
  }
  }
  
  // Exit menu/adjustment with B
  if (inMenu) {
  if (antiRecoilAdjust && currB && !prevB) {
  if (WeaponSpecificSelectMode) {
  WeaponSpecificSelectMode = FALSE;
  } else if (WeaponSelectMode) {
  WeaponSelectMode = FALSE;
  } else {
  antiRecoilAdjust = FALSE;
  }
  } else if (rapidFireAdjust && currB && !prevB) {
  rapidFireAdjust = FALSE;
  } else if (crouchSpamAdjust && currB && !prevB) {
  crouchSpamAdjust = FALSE;
  } else if (shaiikoPeekAdjust && currB && !prevB) {
  shaiikoPeekAdjust = FALSE;
  } else if (shotAbuseAdjust && currB && !prevB) {
  shotAbuseAdjust = FALSE;
  } else if (rsJitterAdjust && currB && !prevB) {
  rsJitterAdjust = FALSE;
  } else if (crouchShotAdjust && currB && !prevB) {
  crouchShotAdjust = FALSE;
  } else if (hipLeanAdjust && currB && !prevB) {
  hipLeanAdjust = FALSE;
  } else if (leanSpamAdjust && currB && !prevB) {
  leanSpamAdjust = FALSE;
  } else if (PronePeekAdjust && currB && !prevB) {
  PronePeekAdjust = FALSE;
  }else if (!antiRecoilAdjust && !rapidFireAdjust && !crouchSpamAdjust && !shaiikoPeekAdjust &&
  !shotAbuseAdjust && !rsJitterAdjust && !crouchShotAdjust && !hipLeanAdjust &&
  !leanSpamAdjust && !PronePeekAdjust && currB && !prevB) {
 

  // If in script switch menu, pressing B goes back to side selection
  if (menuMode == 5 && sideSelected) {
  sideSelected = FALSE;  // Go back to side selection
  }
  // If in any other menu, pressing B goes back to side selection
  else if (menuMode == 3 && sideSelected) {
  sideSelected = FALSE;
  } else {
  inMenu = 0;
  msTimer = 0;
  ignoreInputTimer = 20;
  }
  }
  }
  
  if (inMenu) {
  block_all_inputs();
  
  if (!antiRecoilAdjust && !rapidFireAdjust && !crouchSpamAdjust && !shaiikoPeekAdjust &&
  !shotAbuseAdjust && !rsJitterAdjust && !crouchShotAdjust && !hipLeanAdjust &&
  !leanSpamAdjust && !PronePeekAdjust && !sideSelected) {
  if (currRight && !prevRight) { menuMode = min(5, menuMode + 1); } //Max 5 Because of added switched
  if (currLeft && !prevLeft) { menuMode = max(1, menuMode - 1); }
  }
  
  // Main Menu Mode - Side Selection (Operators or Mods)
  if (menuMode == 1) {
  if (!sideSelected) {
  if (currUp && !prevUp) {
  currentSide = (currentSide - 1);
  if (currentSide < 1) currentSide = 3;  // Check added Switch
  }
  if (currDown && !prevDown) {
  currentSide = (currentSide % 3) + 1; //Check added switch
  }
  
  cls_oled(0);
  print(15, 0, OLED_FONT_MEDIUM, OLED_WHITE, Select[0]);
  
  if (currentSide == 1) {
  print(25, 30, OLED_FONT_MEDIUM, OLED_WHITE, OPERATORS[0]);
  } else if (currentSide == 2) {
  print(25, 30, OLED_FONT_MEDIUM, OLED_WHITE, MODS[0]);
  }
  
  else if (currentSide == 3) {
  print(10, 30, OLED_FONT_SMALL, OLED_WHITE, SWITCH_SCRIPT[0]);
  }
  
  
  if (currA && !prevA) {
  sideSelected = TRUE;
  
  if (currentSide == 1) {
  menuMode = 3;
  } else if (currentSide == 2) {
  menuMode = 4;
  } //Check added switch
  else if (currentSide == 3) {
  menuMode = 5;
  }
  }
  }
  
  }
 

  // Menu Mode 3 - Operator Selection and Recoil Adjustment
  else if (menuMode == 3 && currentSide == 1) {
  if (sideSelected) {
  if (!antiRecoilAdjust && !WeaponSelectMode && !WeaponSpecificSelectMode) {
  cls_oled(0);
  
 

 if (currUp && !prevUp) {
  currentDefender = (currentDefender - 1 + 36) % 36;
  currentPrimaryWeapon = 0;
  currentSecondaryWeapon = 0;
  currentWeapon = 1; // Reset to primary weapon
 }
 if (currDown && !prevDown) {
  currentDefender = (currentDefender + 1) % 36;
  currentPrimaryWeapon = 0;
  currentSecondaryWeapon = 0;
  currentWeapon = 1; // Reset to primary weapon
 }
 

  print(5, 0, OLED_FONT_MEDIUM, OLED_WHITE, DEF[0]);
  print(5, 30, OLED_FONT_MEDIUM, OLED_WHITE, DefenderNames[currentDefender]);
  print(5, 50, OLED_FONT_SMALL, OLED_WHITE, EditPrompt[0]);
  
 

  if (currA && !prevA) {
  WeaponSelectMode = TRUE;
  }
  }
  
  // Weapon type selection (primary/secondary)
  else if (WeaponSelectMode && !WeaponSpecificSelectMode && !antiRecoilAdjust) {
  cls_oled(0);
  
  print(5, 0, OLED_FONT_SMALL, OLED_WHITE, DefenderNames[currentDefender]);
  
  print(5, 16, OLED_FONT_SMALL, OLED_WHITE, Select[0]);
  print(55, 16, OLED_FONT_SMALL, OLED_WHITE, Weapon[0]);
  
  // Toggle between primary/secondary
  if ((currUp && !prevUp) || (currDown && !prevDown)) {
  if (currentWeapon == 1) {
  currentWeapon = 2;
  } else {
  currentWeapon = 1;
  }
  }
  
  // Display current weapon type selection
  print(25, 30, OLED_FONT_MEDIUM, OLED_WHITE, WeaponTypes[currentWeapon-1]);
  print(5, 50, OLED_FONT_SMALL, OLED_WHITE, EditPrompt[0]);
  
 

  if (currA && !prevA) {
  WeaponSpecificSelectMode = TRUE;
  }
  }
