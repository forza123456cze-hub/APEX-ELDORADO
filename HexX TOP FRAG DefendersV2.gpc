msTimer += 10;
cls_oled(0);
print(5, 5, OLED_FONT_MEDIUM, OLED_WHITE, DefenderNames[currentDefender]);

// Display weapon name based on current selection
if (currentWeapon == 1) {
print(5, 25, OLED_FONT_MEDIUM, OLED_WHITE, DefenderPrimaryWeapons[(currentDefender * 3) + currentPrimaryWeapon]);
} else {
print(5, 25, OLED_FONT_MEDIUM, OLED_WHITE, DefenderSecondaryWeapons[(currentDefender * 3) + currentSecondaryWeapon]);
}

if (ModToggle) {
print(5, 44, OLED_FONT_MEDIUM, OLED_WHITE, MODSON[0]);
} else {
print(5, 44, OLED_FONT_MEDIUM, OLED_WHITE, MODSOFF[0]);
}
}

// Toggle all mods with View + LT
if (get_val(XB1_VIEW) && get_val(XB1_LT)) {
if (!lastButtonState && !togglePressed) {
ModToggle = !ModToggle;
togglePressed = TRUE;
msTimer = 0;
}
lastButtonState = TRUE;
} else {
lastButtonState = FALSE;
togglePressed = FALSE;
}

// LED indicators
if (ModToggle) {
set_led(LED_1, 3);
set_led(LED_2, 3);
set_led(LED_3, 0);
} else {
set_led(LED_1, 0);
set_led(LED_2, 3);
set_led(LED_3, 0);
}

if (ignoreInputTimer > 0) ignoreInputTimer -= 10;
else {
// Apply recoil compensation based on the selected operator and weapon
if (ModToggle && get_val(XB1_LT) && get_val(XB1_RT)) {
ry = get_val(XB1_RY);
rx = get_val(XB1_RX);

// Apply deadzone
if (abs(ry) < deadzone) ry = 0;
if (abs(rx) < deadzone) rx = 0;

// Apply the recoil compensation based on current weapon and operator
if (currentWeapon == 1) {
// Primary Weapon
set_val(XB1_RY, clamp(ry + defenderPrimaryVerticalRecoil[currentDefender * 3 + currentPrimaryWeapon], -100, 100));
set_val(XB1_RX, clamp(rx + defenderPrimaryHorizontalRecoil[currentDefender * 3 + currentPrimaryWeapon], -100, 100));
} else {
// Secondary Weapon
set_val(XB1_RY, clamp(ry + defenderSecondaryVerticalRecoil[currentDefender * 3 + currentSecondaryWeapon], -100, 100));
set_val(XB1_RX, clamp(rx + defenderSecondaryHorizontalRecoil[currentDefender * 3 + currentSecondaryWeapon], -100, 100));
}
}

// Rapid Fire
if (ModToggle && RapidFireToggle) {
// Check if current weapon is single-shot

if (currentWeapon == 1) {
weaponToCheck = currentPrimaryWeapon;
} else {
weaponToCheck = currentSecondaryWeapon;
}

isSingleShot = isSingleShotWeapon(currentDefender, currentWeapon, weaponToCheck, 0); // 0 for defender

if (isSingleShot) {
// Check activation condition only for single-shot weapons
shouldFire = FALSE;
if (rapidFireActivation == 1) {
shouldFire = get_val(Fire);
} else {
shouldFire = get_val(ADS) && get_val(Fire);
}

if (shouldFire) {
if (msTimer % rapidFireSpeed == 0) combo_run(RapidFire);
}
}
}

// Crouch Spam
if (ModToggle && CrouchSpamToggle) {
if (crouchSpamMode == 1) {
if (get_val(CrouchButton)) {
crouchHoldTimer += 10;
if (crouchHoldTimer >= crouchActivationTime) {
if (msTimer % crouchSpamSpeed == 0) {
combo_run(CrouchSpam);
}
}
} else {
crouchHoldTimer = 0;
if (crouchSpamState != 0) {
combo_run(CrouchSpam);
}
}
} else if (crouchSpamMode == 2) {
if (get_val(ADS) && get_val(Fire)) {
if (msTimer % crouchSpamSpeed == 0) {
combo_run(CrouchSpam);
}
} else {
crouchHoldTimer = 0;
if (crouchSpamState != 0) {
combo_run(CrouchSpam);
}
}
} else if (crouchSpamMode == 3) {
if (get_val(Fire) && !get_val(XB1_LT)) {
if (msTimer % crouchSpamSpeed == 0) {
combo_run(CrouchSpam);
}
} else {
crouchHoldTimer = 0;
if (crouchSpamState != 0) {
combo_run(CrouchSpam);
}
}
} else if (crouchSpamMode == 4) {
if (msTimer % crouchSpamSpeed == 0) {
combo_run(CrouchSpam);
}
}
}

// T-Bag
if (ModToggle && TBagToggle) {
currLeftButton = get_val(XB1_LEFT);

if (currLeftButton) {
if (leftHoldTimer < 250) {
leftHoldTimer += get_rtime();
}

if (leftHoldTimer >= 250) {
if (msTimer % tBagSpeed == 0) {
combo_run(TBag);
}
}

} else {
if (tBagState != 0) {
set_val(CrouchButton, 0);
tBagState = 0;
}
leftHoldTimer = 0;
}

prevLeftButton = currLeftButton;
}

            // Shaiko Peek
if(ModToggle && ShaiikoPeekToggle && get_val(XB1_LT)){
    if(get_ival(ShaikoLeanRight)) {
        combo_run(LeanOnceRS);
        combo_run(ShaikoCrouchCombo);
    }
    if(get_ival(ShaikoLeanLeft)) {
        combo_run(LeanOnceLS);
        combo_run(ShaikoCrouchCombo);
    }
    set_val(ShaikoLeanRight, 0);
    set_val(ShaikoLeanLeft, 0);
}

// Shot Abuse Activation
if (ModToggle && ShotAbuseToggle && get_val(ADS) && !get_val(Fire)) {
if (!shotAbuseActive) {
shotAbuseActive = TRUE;
combo_run(ShotAbuseRelease);
}
} else {
shotAbuseActive = FALSE;
}

// Jitter Activation Logic
if (ModToggle && RSJitterToggle && get_val(JitterBind)) {
if (abs(get_val(XB1_RX)) < 25 && abs(get_val(XB1_RY)) < 25 && !get_val(Fire)) {
if (rsJitterActive == FALSE) {
rsJitterActive = TRUE;
}
combo_run(RSJitter);
} else {
combo_stop(RSJitter);
rsJitterActive = FALSE;
}
} else {
combo_stop(RSJitter);
rsJitterActive = FALSE;
}

// Crouch Shot
if (ModToggle && CrouchShotToggle) {
set_val(CrouchButton, get_val(CrouchButton));

if(get_val(Fire)) {
if(!lastFire) {
set_val(CrouchButton, 100);
crouchOverride = TRUE;
}
lastFire = TRUE;
} else {
if(lastFire) {
set_val(CrouchButton, 100);
crouchOverride = TRUE;
} else if(crouchOverride) {
set_val(CrouchButton, 0);
crouchOverride = FALSE;
}
lastFire = FALSE;
}
}

// Hip Lean
if(ModToggle && HipLeanToggle) {
if(quickToggleState) {
if(!get_val(ADS)) {
if(!get_val(ADS)) {
if(get_ival(XB1_LX) == 100 && get_lval(XB1_LX) < 100) {
combo_run(HipRight);
}
if(get_ival(XB1_LX) == -100 && get_lval(XB1_LX) > -100) {
combo_run(HipLeft);
}
}
}
}
}

// Lean Spam
if (ModToggle && LeanSpamToggle && get_val(XB1_LT) && get_val(XB1_RT)) {
if (msTimer % leanSpamSpeed == 0) {
combo_run(LeanSpam);
}
} else {
if (leanSpamState != 0) {
set_val(LeanLeft, 0);
set_val(LeanRight, 0);
leanSpamState = 0;
}
}

// PronePeek
if (ModToggle && PronePeekToggle) {
if (get_val(Fire) && !get_val(ADS) && isMoving()) {
fireHoldTime += 10;

if (fireHoldTime >= 50 && !lastFire) {
combo_run(PronePeekCombo);
lastFire = TRUE;
}
} else {
if (lastFire && !get_val(ADS)) {
combo_run(StandUpCombo);
}
fireHoldTime = 0;
lastFire = FALSE;

if (!combo_running(PronePeekCombo) && !combo_running(StandUpCombo)) {
set_val(CrouchButton, 0);
crouchOverride = FALSE;
}
}
}
}
}

// Process adjustments
if (adjustDelayActive) {
adjustDelayTimer--;
if (adjustDelayTimer <= 0) {
adjustDelayActive = FALSE;

if (adjustType == 1) {
// Adjust vertical recoil
if (currentWeapon == 1) {
idx = currentDefender * 3 + currentPrimaryWeapon;
defenderPrimaryVerticalRecoil[idx] = clamp(defenderPrimaryVerticalRecoil[idx] + adjustIncrement, 0, 100);
} else {
idx = currentDefender * 3 + currentSecondaryWeapon;
defenderSecondaryVerticalRecoil[idx] = clamp(defenderSecondaryVerticalRecoil[idx] + adjustIncrement, 0, 100);
}
} else if (adjustType == 2) {
// Adjust horizontal recoil
if (currentWeapon == 1) {
idx = currentDefender * 3 + currentPrimaryWeapon;
defenderPrimaryHorizontalRecoil[idx] = clamp(defenderPrimaryHorizontalRecoil[idx] + adjustIncrement, -100, 100);
} else {
idx = currentDefender * 3 + currentSecondaryWeapon;
defenderSecondaryHorizontalRecoil[idx] = clamp(defenderSecondaryHorizontalRecoil[idx] + adjustIncrement, -100, 100);
}
} else if (adjustType == 3) {
deadzone = clamp(deadzone + adjustIncrement, 1, 80);
} else if (adjustType == 4) {
rapidFireSpeed = clamp(rapidFireSpeed + adjustIncrement, 1, 50);
} else if (adjustType == 5) {
crouchSpamSpeed = clamp(crouchSpamSpeed + adjustIncrement, 1, 50);
} else if (adjustType == 6) {
shaiikoPeekDelay = clamp(shaiikoPeekDelay + adjustIncrement, 31, 100);
} else if (adjustType == 7) {
aimOutDelay = clamp(aimOutDelay + adjustIncrement, 1, 50);
} else if (adjustType == 8) {
rsJitterStrength = clamp(rsJitterStrength + adjustIncrement, 10, 100);
} else if (adjustType == 9) {
leanSpamSpeed = clamp(leanSpamSpeed + adjustIncrement, 1, 50);
} else if (adjustType == 10) {
PronePeekDelay = clamp(PronePeekDelay + adjustIncrement, 20, 500);
}

adjustIncrement = 0;
adjustType = 0;
}
}

// Update previous button states
prevMenu = currMenu;
prevLT = currLT;
prevB = currB;
prevRight = currRight;
prevLeft = currLeft;
prevA = currA;
prevUp = currUp;
prevDown = currDown;
}
int weaponToCheck;
// -----------------------------
// Utility Functions
// -----------------------------

function drawBigDigit(int d, int xPos, int yPos) {
print(xPos, yPos, OLED_FONT_MEDIUM, OLED_WHITE, Numbers[d]);
}

int _absNum = 0;

function isMoving() {
return (abs(get_val(XB1_LX)) > 20 || abs(get_val(XB1_LY)) > 20);
}

function drawBigNumber(int num, int xPos, int yPos) {
_absNum = abs(num);

if (num < 0) {
drawMinusSign(xPos - 12, yPos);

if (_absNum >= 100) {
drawBigDigit(_absNum / 100, xPos, yPos);
drawBigDigit((_absNum / 10) % 10, xPos + 12, yPos);
drawBigDigit(_absNum % 10, xPos + 24, yPos);
} else if (_absNum >= 10) {
drawBigDigit(_absNum / 10, xPos, yPos);
drawBigDigit(_absNum % 10, xPos + 12, yPos);
} else {
drawBigDigit(_absNum, xPos, yPos);
}
} else {
if (_absNum >= 100) {
drawBigDigit(_absNum / 100, xPos, yPos);
drawBigDigit((_absNum / 10) % 10, xPos + 12, yPos);
drawBigDigit(_absNum % 10, xPos + 24, yPos);
} else if (_absNum >= 10) {
drawBigDigit(_absNum / 10, xPos, yPos);
drawBigDigit(_absNum % 10, xPos + 12, yPos);
} else {
drawBigDigit(_absNum, xPos, yPos);
}
}
}

function drawMinusSign(int xPos, int yPos) {
line_oled(xPos, yPos + 6, xPos + 8, yPos + 6, 2, 1);
}
int isSingleShot
// Updated Single Shot Weapon Check
function isSingleShotWeapon(int operatorIndex, int weaponType, int weaponIndex, int isAttacker) {
if (isAttacker == 0) { // DEFENDERS
if (weaponType == 1) { // Primary weapons
// DMRs and slug shotguns
if (operatorIndex == 17 && weaponIndex == 1) return TRUE; // VIGIL - BOSG.12.2
if (operatorIndex == 21 && weaponIndex == 1) return TRUE; // KAID - TCSG12
if (operatorIndex == 24 && weaponIndex == 1) return TRUE; // GOYO - TCSG12
if (operatorIndex == 28 && weaponIndex == 1) return TRUE; // ARUNI - DMR-14
if (operatorIndex == 34 && weaponIndex == 1) return TRUE; // TUBARÃƒO - AR-15.50
} else { // Secondary weapons
// All pistols except machine pistols
if (operatorIndex == 0 && weaponIndex == 1) return TRUE; // SMOKE - P226 MK25
if (operatorIndex == 1 && weaponIndex == 0) return TRUE; // MUTE - P226 MK25
if (operatorIndex == 2 && weaponIndex == 0) return TRUE; // CASTLE - M45 MEUSOC
if (operatorIndex == 2 && weaponIndex == 1) return TRUE; // CASTLE - 5.7 USG
if (operatorIndex == 3 && weaponIndex == 0) return TRUE; // PULSE - M45 MEUSOC
if (operatorIndex == 3 && weaponIndex == 1) return TRUE; // PULSE - 5.7 USG
if (operatorIndex == 4 && weaponIndex == 0) return TRUE; // DOC - P9
if (operatorIndex == 5 && weaponIndex == 0) return TRUE; // ROOK - P9
if (operatorIndex == 6 && weaponIndex == 0) return TRUE; // KAPKAN - PMM
if (operatorIndex == 6 && weaponIndex == 1) return TRUE; // KAPKAN - GSH-18
if (operatorIndex == 7 && weaponIndex == 0) return TRUE; // TACHANKA - PMM
if (operatorIndex == 7 && weaponIndex == 1) return TRUE; // TACHANKA - GSH-18
if (operatorIndex == 8 && weaponIndex == 0) return TRUE; // JÃ„GER - P12
if (operatorIndex == 9 && weaponIndex == 0) return TRUE; // BANDIT - P12
if (operatorIndex == 10 && weaponIndex == 0) return TRUE; // FROST - MK1 9mm
if (operatorIndex == 11 && weaponIndex == 0) return TRUE; // VALKYRIE - D-50
if (operatorIndex == 12 && weaponIndex == 0) return TRUE; // CAVEIRA - PRB92
if (operatorIndex == 13 && weaponIndex == 0) return TRUE; // ECHO - P229
if (operatorIndex == 14 && weaponIndex == 0) return TRUE; // MIRA - USP40
if (operatorIndex == 15 && weaponIndex == 0) return TRUE; // LESION - Q-929
if (operatorIndex == 16 && weaponIndex == 0) return TRUE; // ELA - RG15
if (operatorIndex == 18 && weaponIndex == 1) return TRUE; // MAESTRO - Keratos .357
if (operatorIndex == 19 && weaponIndex == 1) return TRUE; // ALIBI - Keratos .357
if (operatorIndex == 20 && weaponIndex == 1) return TRUE; // CLASH - P-10C
if (operatorIndex == 21 && weaponIndex == 0) return TRUE; // KAID - .44 Mag Semi-Auto
if (operatorIndex == 22 && weaponIndex == 0) return TRUE; // MOZZIE - SDP 9mm
if (operatorIndex == 23 && weaponIndex == 1) return TRUE; // WARDEN - P-10C
if (operatorIndex == 24 && weaponIndex == 0) return TRUE; // GOYO - P229
if (operatorIndex == 25 && weaponIndex == 0) return TRUE; // WAMAI - P12
if (operatorIndex == 26 && weaponIndex == 1) return TRUE; // ORYX - USP40
if (operatorIndex == 27 && weaponIndex == 0) return TRUE; // MELUSI - RG15
if (operatorIndex == 28 && weaponIndex == 0) return TRUE; // ARUNI - PRB92
if (operatorIndex == 29 && weaponIndex == 0) return TRUE; // THUNDERBIRD - Q-929
if (operatorIndex == 30 && weaponIndex == 1) return TRUE; // THORN - 1911 TACOPS
if (operatorIndex == 31 && weaponIndex == 0) return TRUE; // AZAMI - D-50
if (operatorIndex == 35 && weaponIndex == 0) return TRUE; // SENTRY - P12
}
}
return FALSE; // Default to FALSE for full-auto weapons
