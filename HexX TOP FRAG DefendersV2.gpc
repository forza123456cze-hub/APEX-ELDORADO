  else if (WeaponSpecificSelectMode && !antiRecoilAdjust) {
  cls_oled(0);
  
  print(5, 0, OLED_FONT_SMALL, OLED_WHITE, DefenderNames[currentDefender]);
  
  print(5, 16, OLED_FONT_SMALL, OLED_WHITE, Select[0]);
  print(55, 16, OLED_FONT_SMALL, OLED_WHITE, WeaponTypes[currentWeapon-1]);
  
  // Display available weapons for current selection
  if (currentWeapon == 1) {
  // Primary weapons
  if (currUp && !prevUp) {
  currentPrimaryWeapon = (currentPrimaryWeapon - 1 + 3) % 3;
  }
  if (currDown && !prevDown) {
  currentPrimaryWeapon = (currentPrimaryWeapon + 1) % 3;
  }
  
  print(5, 30, OLED_FONT_MEDIUM, OLED_WHITE, DefenderPrimaryWeapons[(currentDefender * 3) + currentPrimaryWeapon]);
  } else {
  // Secondary weapons
  if (currUp && !prevUp) {
  currentSecondaryWeapon = (currentSecondaryWeapon - 1 + 3) % 3;
  }
  if (currDown && !prevDown) {
  currentSecondaryWeapon = (currentSecondaryWeapon + 1) % 3;
  }
  
  print(5, 30, OLED_FONT_MEDIUM, OLED_WHITE, DefenderSecondaryWeapons[(currentDefender * 3) + currentSecondaryWeapon]);
  }
  
  print(5, 50, OLED_FONT_SMALL, OLED_WHITE, EditPrompt[0]);
  
 

  if (currA && !prevA) {
  antiRecoilAdjust = TRUE;
  antiRecoilAdjustMode = 1;
  }
  }
  else if (antiRecoilAdjust) {
  // Recoil Adjustment Mode
  if (currRight && !prevRight) {
  antiRecoilAdjustMode = (antiRecoilAdjustMode % 3) + 1;
  }
  if (currLeft && !prevLeft) {
  antiRecoilAdjustMode = (antiRecoilAdjustMode - 1);
  if (antiRecoilAdjustMode < 1) antiRecoilAdjustMode = 3;
  }
  
  // Vertical Recoil Adjustment
  if (antiRecoilAdjustMode == 1) {
  if (currUp && !adjustDelayActive) {
  adjustType = 1;
  if (currLT) adjustIncrement = 10;
  else adjustIncrement = 1;
  adjustDelayActive = TRUE; adjustDelayTimer = 20;
  }
  if (currDown && !adjustDelayActive) {
  adjustType = 1;
  if (currLT) adjustIncrement = -10;
  else adjustIncrement = -1;
  adjustDelayActive = TRUE; adjustDelayTimer = 20;
  }
  
  cls_oled(0);
  print(5, 0, OLED_FONT_SMALL, OLED_WHITE, DefenderNames[currentDefender]);
  
  // Display weapon name
  if (currentWeapon == 1) {
  print(10, 16, OLED_FONT_SMALL, OLED_WHITE, DefenderPrimaryWeapons[(currentDefender * 3) + currentPrimaryWeapon]);
  } else {
  print(10, 16, OLED_FONT_SMALL, OLED_WHITE, DefenderSecondaryWeapons[(currentDefender * 3) + currentSecondaryWeapon]);
  }
  
  print(80, 16, OLED_FONT_SMALL, OLED_WHITE, AD[0]);
  print(25, 30, OLED_FONT_MEDIUM, OLED_WHITE, VERT[0]);
  
  // Display the appropriate recoil value based on weapon and operator
  if (currentWeapon == 1) {
  drawBigNumber(defenderPrimaryVerticalRecoil[currentDefender * 3 + currentPrimaryWeapon], 49, 45);
  } else {
  drawBigNumber(defenderSecondaryVerticalRecoil[currentDefender * 3 + currentSecondaryWeapon], 49, 45);
  }
  }
// Horizontal Recoil Adjustment
else if (antiRecoilAdjustMode == 2) {
if (currUp && !adjustDelayActive) {
adjustType = 2;
if (currLT) adjustIncrement = 10;
else adjustIncrement = 1;
adjustDelayActive = TRUE; adjustDelayTimer = 20;
}
if (currDown && !adjustDelayActive) {
adjustType = 2;
if (currLT) adjustIncrement = -10;
else adjustIncrement = -1;
adjustDelayActive = TRUE; adjustDelayTimer = 20;
}

