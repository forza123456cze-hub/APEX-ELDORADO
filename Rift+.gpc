// bind is called, check out our free setup tutorials in https://whop.com/tutorials!
//
// So, let's begin!

					ADS 		 = 	XB1_LT,   // Aiming
					Fire 		 = 	XB1_RT,   // Shooting
					Interact	 = 	XB1_X,    // Interacting and Reloading
					Crouch 		 = 	XB1_RS,   // Crouching
					
					Edit 		 = 	XB1_LS,   // Editing a Building
					Reset 		 = 	XB1_LT,   // Resetting an Edit
					Confirm 	 = 	XB1_B,    // Confirming an Edit
					
					InstantReset = 	XB1_LEFT, // Activates "Instant Reset" Macro

// Nice! You're almost done setting everything up, just a little bit more, shouldn't be more than 15 seconds!

					DeadZone 	 = 	5,		  // Right-Stick Dead-Zone

