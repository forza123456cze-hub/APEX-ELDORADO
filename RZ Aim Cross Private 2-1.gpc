function AXRL(AxisXY, AxisVal) {
    if(abs(get_ival(AxisXY)) < ExpoStrength + inv(1) && abs(get_ival(AxisVal)) < ExpoStrength + inv(1) + get_val(ExpoStrength))
        return AxisVal;
    return get_val(AxisXY);
}

