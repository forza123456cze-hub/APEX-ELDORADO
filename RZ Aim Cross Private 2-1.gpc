function fn_gwyjl372(var_hnenH2i6) {
	var_oYvgniOS = get_ival(var_hnenH2i6); 

	if(var_oYvgniOS >= inv(def_OuSOL8om) && var_oYvgniOS <= def_OuSOL8om)
	{
		set_val(var_hnenH2i6, 0); 
	}
	else if(var_oYvgniOS < inv(def_OuSOL8om))
	{
		set_val(var_hnenH2i6, clamp((var_oYvgniOS + def_OuSOL8om) * 100 / (100 - def_OuSOL8om), inv(100), 100));
		
	}
	else if(var_oYvgniOS > def_OuSOL8om)
	{
		set_val(var_hnenH2i6, clamp((var_oYvgniOS - def_OuSOL8om) * 100 / (100 - def_OuSOL8om), inv(100), 100));
		
	}
}






